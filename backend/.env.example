# Anthropic — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI — only needed for Whisper voice fallback
OPENAI_API_KEY=your_openai_key_here

# Optional: override the Claude model
CLAUDE_MODEL=claude-sonnet-4-6

# Serpapi — Google Flights search (serpapi.com, 100 free searches/month)
SERPAPI_KEY=your_serpapi_key_here

REDIS_URL=redis://localhost:6379
SCRAPE_DO_TOKEN=your_scrapedo_token_here
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here
