# Anthropic — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — only needed for Whisper voice fallback
# Get key at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the Claude model
CLAUDE_MODEL=claude-sonnet-4-5

# Amadeus — flight search (sandbox free at developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
